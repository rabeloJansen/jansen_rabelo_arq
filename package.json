{
  "name": "jansen-rabelo-portfolio",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build:projects": "node scripts/build-projects.mjs && prettier --write projects --log-level warn",
    "test": "node --test",
    "check": "node --check src/scripts/app.js && node --check src/scripts/library.js && node --check src/scripts/gallery.js && node --check src/scripts/contact-config.js",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
